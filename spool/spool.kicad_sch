	(text "U8: STM32L073RZT6, replaces the RP2040.\nPin map: spool-rust docs/PORTING_NOTES.md s5.\nR5: BOOT0 pull-down. SW1 + R19 pull BOOT0\nto +3V3 for the ROM bootloader (USB DFU on\nPA11/PA12, UART on PA2/PA3).\nC41: NRST filter cap.\nPC14/PC15 free for an optional 32.768k crystal.\nTODO: LCSC part number for U8."
		(exclude_from_sim no)
		(at 527.05 56.642 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bd6a49a7-2580-4b0e-a5a3-9f8cb6050df6")
	)
